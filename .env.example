# ===== GitHub =====
# 强烈建议配置：未配置时匿名 API 限额为 60 次/小时，配置后为 5000 次/小时
GITHUB_TOKEN=

# ===== LLM（可选）=====
# 不配置时，所有 Agent 自动使用本地规则分析，流水线仍可完整跑通
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# 兼容 OpenAI 协议的网关可在此填写，例如 https://api.openai.com/v1
LLM_BASE_URL=
LLM_TEMPERATURE=0.2

# ===== 抓取限制 =====
MAX_REPO_FILES=200
