# ===== GitHub =====
# 强烈建议配置：未配置时匿名 API 限额为 60 次/小时，配置后为 5000 次/小时
GITHUB_TOKEN=

# ===== LLM（可选）=====
# 不配置时，所有 Agent 自动使用本地规则分析，流水线仍可完整跑通
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# 兼容 OpenAI 协议的网关可在此填写，例如 https://api.openai.com/v1
LLM_BASE_URL=
LLM_TEMPERATURE=0.2

# ===== 抓取限制 =====
MAX_REPO_FILES=200

# ===== 反射弧护栏（创建 PR 前的概率闸门）=====
# 客户端：mock（离线假 Jev，不花钱）/ jev（真 Jev API，需 JEV_API_KEY）/ qwen（Qwen 替身）
# 不装 jev-reflex-gate 时这些配置无效，工作台按原流程执行
REFLEX_CLIENT=mock
# 用 qwen 客户端时必填（百炼控制台的 API-KEY）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# 真 Jev API（可选）
JEV_API_KEY=
# 阈值：0.20/0.65/0.90 是用 30 条评测集对 qwen-plus 校准出来的，换模型请重跑
#   python jev-reflex-gate/examples/calibrate.py --client qwen --write jev-reflex-gate/docs/eval.md
REFLEX_ALLOW_BELOW=0.20
REFLEX_BLOCK_ABOVE=0.65
REFLEX_NOISE_ABOVE=0.90
# 总开关：0 表示完全绕过闸门
REFLEX_ENABLED=1
