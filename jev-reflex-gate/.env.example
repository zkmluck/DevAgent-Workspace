# ===== Jev =====
# 只放环境变量里，永远不要提交真实 key
JEV_API_KEY=

# 客户端：mock（离线假 Jev，默认）或 jev（真实 API）
REFLEX_CLIENT=mock

# 三个可选客户端：
#   mock  —— 离线假 Jev，不花钱，不需要 key（默认）
#   jev   —— 真 Jev Decision API，需要 JEV_API_KEY 且账户里有余额
#   qwen  —— 用 Qwen 扮演 Jev，需要 QWEN_API_KEY

# ===== Qwen 替身（百炼 / DashScope 的 OpenAI 兼容接口）=====
QWEN_API_KEY=
# 建议用百炼控制台里"业务空间专属域名"那条 OpenAI 兼容地址（以 /compatible-mode/v1 结尾），
# 例如 https://ws-xxxxxxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1。
# 同一个业务空间还会给一条 /apps/anthropic（Anthropic 消息格式，给 Claude Code 一类客户端），
# 本项目走 OpenAI 的 /chat/completions，用 /compatible-mode/v1，别拿错。
# 公共 DashScope 域名自 2026-09-30 起进维护状态，仅作兜底。
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT_S=30
QWEN_MAX_TOKENS=1024
# 有些兼容服务不接受 response_format，设 0 可禁用（代码里已有一次自动回退）
QWEN_JSON_MODE=1

# 官方直连可改成 https://api.typesafe.ai/v1/systemone
JEV_ENDPOINT=https://jevtypesafeai.com/api/v1/decide

# ===== 分流阈值 =====
# 下面这组是用 eval/ 里 30 条评测集对 qwen-plus 实测校准出来的（见 docs/eval.md）：
# 误放行 0、误拦 0、正确 25/30。
# 真 Jev 的校准特性不同，换模型请重跑：
#   python examples/calibrate.py --client qwen --write docs/eval.md
# 低于此值且风险类别为 routine、噪音也低时自动放行
REFLEX_ALLOW_BELOW=0.20
# 达到此值时直接拦截
REFLEX_BLOCK_ABOVE=0.65
# 达到此值时只降级为草稿（没价值 ≠ 危险）
REFLEX_NOISE_ABOVE=0.90

# ===== 其他 =====
# 总开关，0 表示完全绕过闸门（回到接入前的行为）
REFLEX_ENABLED=1
REFLEX_TIMEOUT_S=8
REFLEX_MAX_RETRIES=1
REFLEX_AUDIT_PATH=output/reflex/audit.jsonl
